#: inc/class-otpa-settings.php:290
msgid "Enable Passwordless Authentication"
msgstr ""

#: inc/class-otpa-settings.php:293
msgid "When Passwordless Authentication is enabled, users can choose to log in with the selected Authentication Gateway instead of using their login and password."
msgstr ""

#: inc/class-otpa-settings.php:293
msgid "Passwordless Authentication and Two-Factor Authentication cannot be enabled at the same time."
msgstr ""

#: inc/class-otpa-settings.php:297
msgid "Roles to include for Passwordless Authentication"
msgstr ""

#: inc/class-otpa-settings.php:302
msgid "Passwordless authentication applies only to users with a selected role. Subscriber is selected automatically when no other role is selected."
msgstr ""

#: inc/class-otpa-settings.php:306
msgid "Enable Account Validation"
msgstr ""

#: inc/class-otpa-settings.php:309
msgid "When Account Validation is enabled, logged in users with an account not previously validated or with an expired account validation are asked to validate their account with the selected Authentication Gateway before accessing the website."
msgstr ""

#: inc/class-otpa-settings.php:309
msgid "Users will automatically be asked to validate their account upon editing the identifier used by the selected Authentication Gateway."
msgstr ""

#: inc/class-otpa-settings.php:309
msgid "An account is validated whenever an OTP Verification Code is successfully used (including during Passwordless Authentication if enabled)."
msgstr ""

#: inc/class-otpa-settings.php:309
msgid "Account Validation and Two-Factor Authentication cannot be enabled at the same time."
msgstr ""

#: inc/class-otpa-settings.php:313
msgid "Account Validation Expiry"
msgstr ""

#: inc/class-otpa-settings.php:319
#: inc/class-otpa-settings.php:385
msgid "Expressed in hours."
msgstr ""

#: inc/class-otpa-settings.php:319
msgid "After the specified duration, at their next login, users will be asked to validate their account again before accessing the website."
msgstr ""

#: inc/class-otpa-settings.php:319
msgid "Set this value to -1 to never expire the validation ; set this value to 0 to force users to validate their account each time they log in."
msgstr ""

#: inc/class-otpa-settings.php:323
msgid "Roles excluded from Account Validation"
msgstr ""

#: inc/class-otpa-settings.php:328
msgid "Selected roles will not be asked to validate their account before accessing the website."
msgstr ""

#: inc/class-otpa-settings.php:332
msgid "Sandbox Mode"
msgstr ""

#: inc/class-otpa-settings.php:335
msgid "When Sandbox Mode is on, the Authentication Gateway is bypassed and the One-Time Password Verification Code is send to the Activity Logs only."
msgstr ""

#: inc/class-otpa-settings.php:335
msgid "Do not use in production, users requesting OTP Verification Codes will not receive them!"
msgstr ""

#: inc/class-otpa-settings.php:339
msgid "OTP Verification Code Max. Requests"
msgstr ""

#: inc/class-otpa-settings.php:345
msgid "Maximum number of One-Time Password Verification Code requests allowed before the user gets temporarily blocked from requesting a new code."
msgstr ""

#: inc/class-otpa-settings.php:345
msgid "If the number of requests reaches this value for a given user, OTP Verification Codes and requests are temporarily unusable."
msgstr ""

#: inc/class-otpa-settings.php:345
#: inc/class-otpa-settings.php:355
msgid "Allowance is reset automatically after the user successfully used an OTP Verification Code, when the OTP Temporary Block expired, or when the OTP Tracking expired."
msgstr ""

#: inc/class-otpa-settings.php:345
msgid "Set this value to 0 to allow unlimited requests (discouraged)."
msgstr ""

#: inc/class-otpa-settings.php:349
msgid "Max. Failed Verification Attempts"
msgstr ""

#: inc/class-otpa-settings.php:355
msgid "Maximum number of failed One-Time Password Verification Code submission attempts allowed."
msgstr ""

#: inc/class-otpa-settings.php:355
msgid "If the number of failed attempts reaches this value for a given user, OTP Verification Codes and requests are temporarily unusable."
msgstr ""

#: inc/class-otpa-settings.php:355
msgid "Set this value to 0 to allow unlimited attempts (discouraged)."
msgstr ""

#: inc/class-otpa-settings.php:359
msgid "OTP Verification Code Request Frequency"
msgstr ""

#: inc/class-otpa-settings.php:365
msgid "Expressed in secondes."
msgstr ""

#: inc/class-otpa-settings.php:365
msgid "Frequency of allowed One-Time Password Verification Code requests."
msgstr ""

#: inc/class-otpa-settings.php:365
msgid "Prevents users from requesting codes too often."
msgstr ""

#: inc/class-otpa-settings.php:369
msgid "OTP Verification Code Expiry"
msgstr ""

#: inc/class-otpa-settings.php:375
#: inc/class-otpa-settings.php:395
msgid "Expressed in minutes."
msgstr ""

#: inc/class-otpa-settings.php:375
msgid "The amount of time after which the One-Time Password Verification Code is no longer valid."
msgstr ""

#: inc/class-otpa-settings.php:375
msgid "It is recommended to keep this value low, but no too low otherwise the users would be unable to receive and type their code before it expires."
msgstr ""

#: inc/class-otpa-settings.php:375
#: inc/class-otpa-settings.php:395
msgid "Minimum 1 minute."
msgstr ""

#: inc/class-otpa-settings.php:379
msgid "OTP Tracking Expiry"
msgstr ""

#: inc/class-otpa-settings.php:385
msgid "Used to determine when to expire \"OTP Verification Code Max. Requests\" and \"Max. Failed Verification Attempts\"."
msgstr ""

#: inc/class-otpa-settings.php:385
msgid "Minimum 1 hour."
msgstr ""

#: inc/class-otpa-settings.php:389
msgid "OTP Temporary Block Expiry"
msgstr ""

#: inc/class-otpa-settings.php:395
msgid "If one of \"OTP Verification Code Max. Requests\" or \"Max. Failed Verification Attempts\" is greater than 0 and is reached for a given user, this value determines how long the OTP Authentication is unusable."
msgstr ""

